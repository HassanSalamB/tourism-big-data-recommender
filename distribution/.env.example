APP_IMAGE=ghcr.io/your-github-user/holiday-itinerary:commit-sha
AIRFLOW_IMAGE=ghcr.io/your-github-user/holiday-itinerary-airflow:commit-sha

PUBLIC_BIND_ADDRESS=127.0.0.1
FASTAPI_PORT=8000
STREAMLIT_PORT=8501
AIRFLOW_PORT=8088
KAFKA_UI_PORT=8090
SPARK_UI_PORT=8080
NEO4J_BROWSER_PORT=7474
PROMETHEUS_PORT=9090
ALERTMANAGER_PORT=9093
GRAFANA_PORT=3000
ADMINER_PORT=5050

# Set only on the future VM. Leave this example value unchanged in Git.
CLOUDFLARE_TUNNEL_TOKEN=set-on-the-proxmox-vm-only
BACKUP_DIRECTORY=/var/backups/holiday-platform

DATATOURISME_TOKEN=your_api_key_or_feed_id

DB_USER=platform_admin
DB_PASSWORD=replace-with-a-long-random-password
DB_NAME=holiday_db
DB_PORT=5432
DB_HOST=postgres

NEO4J_USER=neo4j
NEO4J_PASSWORD=neo4jpassword
NEO4J_URI=bolt://neo4j:7687
NEO4J_HOST=neo4j
NEO4J_PORT=7687

KAFKA_BOOTSTRAP_SERVERS=kafka:9092
AIRFLOW_UID=50000
AIRFLOW_DB_PASSWORD=replace-with-a-different-long-random-password
AIRFLOW_ADMIN_USERNAME=platform_admin
AIRFLOW_ADMIN_PASSWORD=replace-with-another-long-random-password
AIRFLOW_ADMIN_EMAIL=admin@example.com
AIRFLOW_WEBSERVER_SECRET_KEY=replace-with-at-least-32-random-characters

GRAFANA_ADMIN_USER=platform_admin
GRAFANA_ADMIN_PASSWORD=replace-with-a-long-random-password

SPARK_WORKER_CORES=2
SPARK_WORKER_MEMORY=2G
SPARK_DRIVER_MEMORY=1g
SPARK_EXECUTOR_MEMORY=1g
SPARK_EXECUTOR_CORES=1
SPARK_SQL_SHUFFLE_PARTITIONS=8

SNOWFLAKE_ACCOUNT=your-account
SNOWFLAKE_USER=your-user
SNOWFLAKE_PASSWORD=your-password
SNOWFLAKE_ROLE=TRANSFORMER
SNOWFLAKE_DATABASE=HOLIDAY_ITINERARY
SNOWFLAKE_WAREHOUSE=TRANSFORMING_WH
SNOWFLAKE_SCHEMA=ANALYTICS
