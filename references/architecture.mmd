graph LR
    %% Data Source
    API[("🌐 DATAtourisme API<br/>(ZIP Stream)")] 

    %% Bronze Layer
    subgraph Bronze [<b>BRONZE LAYER - Data Lake</b>]
        direction TB
        Ingestor[("🐍 Python Ingestor")]
        DB_Raw[("🐘 PostgreSQL<br/>(JSONB Table)")]
    end

    %% Silver Layer
    subgraph Silver [<b>SILVER LAYER - Processing</b>]
        direction TB
        Processor[("🐍 Python Processor")]
    end

    %% Gold Layer
    subgraph Gold [<b>GOLD LAYER - Warehouse</b>]
        direction TB
        SQL_Gold[("🐘 PostgreSQL DW")]
        Neo_Gold[("🌿 Neo4j Graph")]
    end

    %% Connections
    API -->|1. Download & Unzip| Ingestor
    Ingestor -->|2. Bulk Insert| DB_Raw
    DB_Raw -->|3. Read JSONB| Processor
    Processor -->|4a. Flatten POIs| SQL_Gold
    Processor -->|4b. Link Metadata| Neo_Gold